# Migriga Analytics configuration (all optional). The app reads these from the process
# environment; there is no .env loader, so export them in your shell before starting, e.g.
#   export MIGRIGA_SOURCE_CSV=/path/to/online_retail_09_10.csv
#
# Source CSV for the ETL pipeline (default: data/raw/online_retail_09_10.csv)
MIGRIGA_SOURCE_CSV=data/raw/online_retail_09_10.csv
# SQLite analytics warehouse (default: data/warehouse/migriga_warehouse.db)
MIGRIGA_WAREHOUSE_PATH=data/warehouse/migriga_warehouse.db
# Where the fitted K-Means model metadata is written (default: data/processed/segmentation_model.json)
MIGRIGA_MODEL_PATH=data/processed/segmentation_model.json
